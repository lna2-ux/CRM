<div class="card">
  <% if customer.image.attached? %>
    <div class="card-image">
      <figure class="image is-square">
        <%= image_tag url_for(customer.image) %>
      </figure>
    </div>
  <% end %>
  
  <div class="card-content">
    <p class="title is-5 mb-3"><%= customer.full_name %></p>
    
    <div class="content">
      <p class="is-size-7 mb-1"><strong>Phone:</strong> <%= customer.phone_number %></p>
      <p class="is-size-7 mb-1"><strong>Email:</strong> <%= customer.email_address.presence || "N/A" %></p>
      <p class="is-size-7 mb-0"><strong>Notes:</strong> <%= customer.notes.presence || "No notes provided" %></p>
    </div>
  </div>
</div>